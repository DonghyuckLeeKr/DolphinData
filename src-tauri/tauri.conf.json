{
  "build": {
    "beforeDevCommand": "npm run dev",
    "beforeBuildCommand": "npm run build",
    "devPath": "http://localhost:5173",
    "distDir": "../dist",
    "withGlobalTauri": false
  },
  "package": {
    "productName": "DolphinData",
    "version": "1.4.0"
  },
  "tauri": {
    "allowlist": {
      "all": false,
      "notification": {
        "all": true
      },
      "window": {
        "all": false,
        "setAlwaysOnTop": true,
        "setSize": true,
        "show": true,
        "hide": true,
        "close": true,
        "minimize": true,
        "maximize": true,
        "unmaximize": true,
        "startDragging": true
      },
      "shell": {
        "open": true
      }
    },
    "bundle": {
      "active": true,
      "category": "Utility",
      "copyright": "Copyright © 2026 DolphinData contributors",
      "externalBin": [],
      "icon": [
        "icons/32x32.png",
        "icons/128x128.png",
        "icons/128x128@2x.png",
        "icons/icon.icns",
        "icons/icon.ico"
      ],
      "identifier": "com.datausage.counter",
      "longDescription": "돌핀 데이터 (Dolphin Data) - 실시간 네트워크 트래픽 & 데이터 사용량 모니터링 프로그램",
      "shortDescription": "돌핀 데이터 (Dolphin Data)",
      "targets": "all",
      "windows": {
        "nsis": {
          "installMode": "perMachine"
        }
      }
    },
    "security": {
      "csp": "default-src 'self' tauri:; img-src 'self' asset: data:; font-src 'self' data:; style-src 'self' 'unsafe-inline'; connect-src ipc: http://ipc.localhost http://192.168.0.1 http://192.168.1.1 http://192.168.8.1 http://192.168.100.1"
    },
    "updater": {
      "active": true,
      "dialog": false,
      "endpoints": [
        "https://github.com/DonghyuckLeeKr/DolphinData/releases/latest/download/latest.json"
      ],
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEIxNjhBNzM2Q0Y1MEFDQ0MKUldUTXJGRFBOcWRvc1lRRk9Mb1VGR3hHZVBsNlYrTGR6M0Z0OFdVazVDaEZPak42aEp4dHFObkoK",
      "windows": {
        "installMode": "passive"
      }
    },
    "systemTray": {
      "iconPath": "icons/icon.png",
      "iconAsTemplate": false,
      "menuOnLeftClick": false
    },
    "windows": [
      {
        "fullscreen": false,
        "height": 760,
        "width": 1120,
        "minHeight": 120,
        "minWidth": 260,
        "resizable": true,
        "title": "돌핀 데이터 (Dolphin Data)",
        "transparent": true,
        "decorations": false,
        "center": true,
        "label": "main"
      }
    ]
  }
}
